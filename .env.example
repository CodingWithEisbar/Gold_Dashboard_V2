APP_ENV=production
# Read-only containers require file-backed Compose secrets. Paths only; never secret values here.
# infra/init-local-env.py creates these files for local use.
DB_ADMIN_PASSWORD_FILE=./.secrets/db_admin_password
DB_OWNER_PASSWORD_FILE=./.secrets/db_owner_password
DB_READER_PASSWORD_FILE=./.secrets/db_reader_password
DB_INGESTOR_PASSWORD_FILE=./.secrets/db_ingestor_password
# For CLI outside Compose only; URL-encode password. Do not expose DB host publicly.
DATABASE_URL=postgresql+psycopg://gold_owner:REPLACE_ME@127.0.0.1:5432/gold
XAU_API_KEY=
METALS_LICENSE_CONFIRMED=false
# Token riêng để xem API Gateway trên bản deploy. Local chạy qua start.sh có thể xem trực tiếp.
API_GATEWAY_TOKEN=
# Enable only after confirming storage/redisplay rights AND KGB per-chi units / Vietnam timezone.
BTMH_ENABLED=false
BTMH_LICENSE_CONFIRMED=false
BTMH_CONVENTIONS_CONFIRMED=false
BTMH_MIN_INTERVAL_MINUTES=30
BTMH_MAX_AGE_HOURS=24
# Dokploy uses this as documentation only; create the Compose Schedule Job explicitly.
BTMH_INGESTION_CRON=*/30 1-11 * * *
INGESTION_CRON=0 11 * * *
SOURCE_ALLOWLIST=api.metals.dev,baotinmanhhai.vn,www.vang.today
REQUEST_TIMEOUT_SECONDS=10
# For release: private registry image@sha256:digest. Leave defaults for local builds.
BACKEND_IMAGE=gold-backend:local
FRONTEND_IMAGE=gold-frontend:local
POSTGRES_IMAGE=gold-postgres:local
# Local domestic quotes use the Vàng.Today public integration API.
VANG_TODAY_ENABLED=true
# Investing.com requires COMPOSE_PROFILES=price-browser and catalog approval.
INVESTING_ENABLED=false
