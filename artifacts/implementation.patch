+          npm ci --ignore-scripts
+          npm run lint
+          npm run typecheck
+          npm run build
+          npm audit --json > ../artifacts/npm-audit.json
+          npm audit --omit=dev --json > ../artifacts/npm-audit-runtime.json
+      - name: Security scanners (verified release checksums)
+        run: |
+          mkdir -p .tools/security
+          cd .tools/security
+          curl -fsSLO https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz
+          curl -fsSLO https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_checksums.txt
+          sha256sum --check --ignore-missing gitleaks_8.30.1_checksums.txt
+          tar -xzf gitleaks_8.30.1_linux_x64.tar.gz gitleaks
+          curl -fsSLO https://github.com/aquasecurity/trivy/releases/download/v0.76.2/trivy_0.76.2_Linux-64bit.tar.gz
+          curl -fsSLO https://github.com/aquasecurity/trivy/releases/download/v0.76.2/trivy_0.76.2_checksums.txt
+          sha256sum --check --ignore-missing trivy_0.76.2_checksums.txt
+          tar -xzf trivy_0.76.2_Linux-64bit.tar.gz trivy
+          curl -fsSLO https://github.com/google/osv-scanner/releases/download/v2.7.0/osv-scanner_linux_amd64
+          curl -fsSLO https://github.com/google/osv-scanner/releases/download/v2.7.0/osv-scanner_SHA256SUMS
