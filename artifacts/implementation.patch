+          .tools/security/gitleaks dir . --redact --report-format json --report-path artifacts/gitleaks.json
+          .tools/security/osv-scanner_linux_amd64 scan source --lockfile frontend/package-lock.json --lockfile requirements.txt:backend/requirements.lock --format json --output-file artifacts/osv.json
+          .tools/security/trivy fs --scanners vuln,misconfig,secret --skip-dirs .tools --skip-dirs artifacts --skip-dirs frontend/node_modules --severity HIGH,CRITICAL --exit-code 1 --format json --output artifacts/trivy-fs.json .
