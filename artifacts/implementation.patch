+          #!/usr/bin/env bash
+          exec docker run --rm --network host -v "$PWD:$PWD" -w "$PWD" -v /tmp:/tmp -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE postgres:18.6-alpine pg_dump "$@"
+          SCRIPT
+          cat > .tools/pg-client/pg_restore <<'SCRIPT'
+          #!/usr/bin/env bash
+          exec docker run --rm --network host -v "$PWD:$PWD" -w "$PWD" -v /tmp:/tmp -e PGHOST -e PGPORT -e PGUSER -e PGPASSWORD -e PGDATABASE postgres:18.6-alpine pg_restore "$@"
+          SCRIPT
+          chmod +x .tools/pg-client/pg_dump .tools/pg-client/pg_restore
+          echo "$PWD/.tools/pg-client" >> "$GITHUB_PATH"
+      - name: Backend tests and audits
+        env:
+          TEST_DATABASE_URL: postgresql+psycopg://postgres:ci-test-only@localhost:5432/gold_test_ci
+        run: |
+          python -m pip install --require-hashes -r backend/requirements-dev.lock
+          mkdir -p artifacts
+          python -m ruff check --config backend/pyproject.toml backend/app backend/tests backend/migrations
+          python -m pytest -q --junitxml=artifacts/backend-tests.xml
+          python -m pip_audit -r backend/requirements.lock --format json --output artifacts/pip-audit.json
+      - name: Frontend checks
+        working-directory: frontend
